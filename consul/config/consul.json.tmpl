{
  "datacenter": "dc1",
  "server": true,
  "bootstrap_expect": 1,
  "data_dir": "/consul/data",
  "client_addr": "0.0.0.0",
  "ui_config": {
    "enabled": true
  },
  "ports": {
    "http": 8500,
    "dns": -1,
    "grpc": -1
  },
  "acl": {
    "enabled": true,
    "default_policy": "allow",
    "enable_token_persistence": true,
    "tokens": {
      "initial_management": "__CONSUL_HTTP_TOKEN__"
    }
  },
  "log_level": "INFO"
}
