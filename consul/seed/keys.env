# Claves iniciales del KV. Formato: <clave>=<valor>; el valor puede contener '='.
# Precedencia en los servicios: env > KV > default.

pdf-extractext/config/api/MAX_FILE_SIZE_MB=16
pdf-extractext/config/api/EXTRACTION_URL=http://traefik:8090
pdf-extractext/config/api/EXTRACTION_HOST=extraction.pdf-extractext.localhost
pdf-extractext/config/api/PERSISTENCE_URL=http://traefik:8090
pdf-extractext/config/api/PERSISTENCE_HOST=persistence.pdf-extractext.localhost

pdf-extractext/config/extraction/MAX_UPLOAD_BYTES=67108864
pdf-extractext/config/extraction/MAX_CONCURRENCY=1
pdf-extractext/config/extraction/RETRY_AFTER_SECONDS=1

pdf-extractext/config/persistence/MONGO_DATABASE_NAME=pdf_extractext
pdf-extractext/config/persistence/MONGO_COLLECTION_NAME=documents
