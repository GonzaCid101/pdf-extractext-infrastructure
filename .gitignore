# Secretos / entorno local — NUNCA versionar .env
.env

# Datos runtime (jamás bind-mount de Mongo versionado)
mongodata/
*-data/

# Caches / SO
.DS_Store
*.log

# Certificados TLS locales (mkcert) — cada dev genera los suyos, nunca versionar
traefik/certs/

# Fixtures de carga: regenerables con tests/load/pdfs/generate_fixtures.sh
tests/load/pdfs/*.pdf
