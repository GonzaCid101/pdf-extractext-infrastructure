# Secretos / entorno local — NUNCA versionar .env
.env

# Datos runtime (jamás bind-mount de Mongo versionado)
mongodata/
*-data/

# Caches / SO
.DS_Store
*.log
__pycache__/

# Certificados TLS locales (mkcert) — cada dev genera los suyos, nunca versionar
traefik/certs/

# PDFs oficiales (tests/load/pdfs/): versionados, no ignorar (un clon limpio debe correr las pruebas).

# Artefactos transitorios de pruebas de carga (no versionar)
tests/load/.k6-summary.json
tests/load/.vegeta-results.bin
tests/load/.vegeta-report.json

# Corridas de carga: locales; solo TEMPLATE.md se versiona.
docs/test-runs/*
