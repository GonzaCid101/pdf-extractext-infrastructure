# Valores de DESARROLLO. Copiar a .env (nunca versionar .env).

# MongoDB — versión definitiva acordada (docs/pending-decisions.md).
MONGO_IMAGE=mongo:8
MONGO_INITDB_ROOT_USERNAME=dev
MONGO_INITDB_ROOT_PASSWORD=dev

# Extraction — build desde repo hermano. Ajustar la ruta si difiere.
EXTRACTION_CONTEXT=../pdf-extractext-extractor

# Persistence — build desde repo hermano. Ajustar la ruta si difiere.
PERSISTENCE_CONTEXT=../pdf-extractext-persistence
